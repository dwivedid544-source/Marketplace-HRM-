# ==============================================================================
# Kiaan HRM Pro — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables for your environment.
# Never commit real secrets, passwords, or production credentials to source control.
# ==============================================================================

# Server Configuration
PORT=5001

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hrm-saas-kiaan

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_characters_here

# ==============================================================================
# Superadmin First-Install Bootstrap Credentials
# ==============================================================================
# NOTE: These variables are used ONLY on fresh installations where NO Superadmin
# account exists in the database.
# 
# Security Constraints:
# 1. SUPERADMIN_BOOTSTRAP_EMAIL must be a valid email format.
# 2. SUPERADMIN_BOOTSTRAP_PASSWORD must be at least 10 characters long.
# 3. If a Superadmin already exists, these variables are completely ignored.
# 4. If the email collides with any existing tenant user, provisioning aborts.
# 5. RECOMMENDED: Remove or unset SUPERADMIN_BOOTSTRAP_PASSWORD after the initial
#    Superadmin account has been successfully provisioned.
# ==============================================================================
SUPERADMIN_BOOTSTRAP_EMAIL=superadmin@example.com
SUPERADMIN_BOOTSTRAP_PASSWORD=

# Biometric Device Settings
MACHINE_IP=192.168.1.201
MACHINE_PORT=4370

# AI Integration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Service (Brevo / Sendinblue API)
BREVO_API_KEY=
MAIL_FROM_NAME=Kiaan Technology Pvt Ltd
MAIL_FROM_EMAIL=info@example.com
MAIL_FROM=Kiaan Technology Pvt Ltd <info@example.com>

# Optional SMTP Fallback
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=info@example.com
SMTP_PASS=
SMTP_SENDER_EMAIL=info@example.com
SMTP_SENDER_NAME=Kiaan Technology Pvt Ltd
